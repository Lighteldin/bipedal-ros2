<?xml version="1.0"?>
<robot name="humanoid_kick_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Simplified bipedal lower body (PART 1 - Mechanical Design)
       Fixed base (stands on a flat surface), two legs, each leg has
       4 servo joints: waist (hip yaw), thigh (hip pitch, theta1),
       shin (knee, theta2), foot (ankle). A pan camera sits on the
       torso. This mirrors the physical channel map exactly:

         CH7  camera_pan     CH11 right_thigh
         CH8  left_waist     CH12 left_shin
         CH9  right_waist    CH13 right_shin
         CH10 left_thigh     CH14 left_foot
                              CH15 right_foot
       ============================================================ -->

  <xacro:property name="thigh_len" value="0.090"/>
  <xacro:property name="shin_len" value="0.085"/>
  <xacro:property name="link_radius" value="0.012"/>
  <xacro:property name="hip_sep" value="0.05"/>
  <xacro:property name="torso_depth" value="0.025"/>   <!-- front-to-back (x) -->
  <xacro:property name="torso_width" value="0.10"/>   <!-- left-to-right (y) -->
  <xacro:property name="torso_height" value="0.15"/>  <!-- vertical (z) - tall, upright torso -->

  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="orange"><color rgba="0.9 0.45 0.05 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- Fixed base: the robot stands on this (PART 1: "fixed base") -->
  <link name="base_footprint"/>

  <!-- Upright torso, standing like a human body (tall box: depth x width x height) -->
  <link name="base_link">
    <visual>
      <geometry><box size="${torso_depth} ${torso_width} ${torso_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${torso_depth} ${torso_width} ${torso_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- base_link is centered on its own origin, so its bottom face sits at
       -torso_height/2 - place that bottom face right on top of the legs. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${thigh_len+shin_len+torso_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Camera (CH7): mounted on TOP of the torso, facing forward (+x) -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="${torso_depth/2 - 0.005} 0 ${torso_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.03 0.02"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="camera_pan" type="revolute">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.05" upper="1.05" effort="1.0" velocity="3.0"/> <!-- +-60 deg from neutral (~30-150 deg servo) -->
  </joint>

  <!-- ============ Leg macro (waist -> thigh -> shin -> foot) ============ -->
  <xacro:macro name="leg" params="side y_off">

    <link name="${side}_waist_link">
      <visual><geometry><cylinder radius="0.015" length="0.02"/></geometry><material name="dark"/></visual>
    </link>
    <joint name="${side}_waist" type="revolute">
      <parent link="base_link"/>
      <child link="${side}_waist_link"/>
      <origin xyz="-0.02 ${y_off} -${torso_height/2}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.35" upper="0.35" effort="1.0" velocity="3.0"/> <!-- +-20 deg from neutral (~70-110 deg servo) -->
    </joint>

    <!-- thigh_link origin = hip joint = IK frame origin for this leg -->
    <link name="${side}_thigh_link">
      <visual>
        <origin xyz="0 0 -${thigh_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${thigh_len}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 -${thigh_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${thigh_len}"/></geometry>
      </collision>
      <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    </link>
    <joint name="${side}_thigh" type="revolute">
      <parent link="${side}_waist_link"/>
      <child link="${side}_thigh_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/> <!-- pitch: sagittal plane matches FK x-y model -->
      <limit lower="-1.05" upper="1.05" effort="1.0" velocity="3.0"/> <!-- +-60 deg from neutral (~30-150 deg servo) -->
    </joint>

    <link name="${side}_shin_link">
      <visual>
        <origin xyz="0 0 -${shin_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${shin_len}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 -${shin_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${shin_len}"/></geometry>
      </collision>
      <inertial><mass value="0.04"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    </link>
    <joint name="${side}_shin" type="revolute">
      <parent link="${side}_thigh_link"/>
      <child link="${side}_shin_link"/>
      <origin xyz="0 0 -${thigh_len}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.22" upper="1.22" effort="1.0" velocity="3.0"/> <!-- +-70 deg from neutral (~20-160 deg servo) -->
    </joint>

    <link name="${side}_foot_link">
      <visual>
        <origin xyz="0.02 0 0"/>
        <geometry><box size="0.05 0.025 0.01"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0.02 0 0"/>
        <geometry><box size="0.05 0.025 0.01"/></geometry>
      </collision>
      <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="${side}_foot" type="revolute">
      <parent link="${side}_shin_link"/>
      <child link="${side}_foot_link"/>
      <origin xyz="0 0 -${shin_len}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.52" upper="0.52" effort="1.0" velocity="3.0"/> <!-- +-30 deg from neutral (~60-120 deg servo) -->
    </joint>

  </xacro:macro>

  <xacro:leg side="left" y_off="${hip_sep/2}"/>
  <xacro:leg side="right" y_off="-${hip_sep/2}"/>

</robot>
